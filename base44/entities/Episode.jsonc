{
  "name": "Episode",
  "type": "object",
  "properties": {
    "anime_id": {
      "type": "string"
    },
    "episode_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "description": "Seconds"
    },
    "intro_start": {
      "type": "number"
    },
    "intro_end": {
      "type": "number"
    },
    "outro_start": {
      "type": "number"
    },
    "has_sub": {
      "type": "boolean",
      "default": true
    },
    "has_dub": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "anime_id",
    "episode_number",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}